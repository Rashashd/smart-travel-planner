# ── Database ────────────────────────────────────────────────────────────────
# Local dev (Docker db exposed on 5433 to avoid clash with local Postgres)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/travel
# Inside Docker (backend container → db container)
# DATABASE_URL=postgresql+asyncpg://app:app@db:5432/travel

# ── ML Classifier ────────────────────────────────────────────────────────────
# Local dev — absolute path to classifier.joblib
CLASSIFIER_PATH=/absolute/path/to/backend/ml/classifier.joblib
# Inside Docker
# CLASSIFIER_PATH=/app/ml/classifier.joblib

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Models (optional — defaults shown) ──────────────────────────────────────
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here
JWT_ALGO=HS256

# ── Slack Webhook ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── LangSmith Tracing (optional) ────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=smart-travel-planner
# Only set if your account is on the EU plan:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ── Cache ────────────────────────────────────────────────────────────────────
# TTL in seconds for weather + FX API responses (default: 600 = 10 minutes)
WEATHER_CACHE_TTL=600
